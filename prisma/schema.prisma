// prisma/schema.postgres.prisma.bak holds an alternative version of this
// schema with exact Decimal(10,2) money fields instead of Float, for a
// future precision upgrade. Not required for deploy — Float maps cleanly to
// Postgres double precision and matches the arithmetic already used in app code.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  COMMUNITY_LEADER
  SUPER_ADMIN
}

enum ClubStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  ZELLE
  CASH_APP
  BANK_TRANSFER
  CASH
  OTHER
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DurationUnit {
  WEEK
  MONTH
}

enum Frequency {
  WEEKLY
  BI_WEEKLY
  EVERY_OTHER_WEEK
  MONTHLY
}

enum TrustTier {
  BRONZE
  SILVER
  GOLD
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String?
  fullName       String
  phone          String?
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    ClubMember[]
  createdClubs   SavingsClub[]   @relation("ClubAdmin")
  paymentReports PaymentReport[]
  approvedReports PaymentReport[] @relation("ReportApprover")
  announcements  Announcement[]

  // Reputation
  completedClubsCount Int       @default(0)
  onTimePaymentsCount Int       @default(0)
  totalPaymentsCount  Int       @default(0)
  punctualityScore    Float     @default(100)
  averageRating       Float     @default(5)
  trustTier           TrustTier @default(BRONZE)
  ratingsGiven        Rating[]  @relation("RatingAuthor")
  ratingsReceived     Rating[]  @relation("RatingTarget")
}

model Rating {
  id        String   @id @default(uuid())
  clubId    String
  authorId  String
  targetId  String
  stars     Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  club   SavingsClub @relation(fields: [clubId], references: [id])
  author User        @relation("RatingAuthor", fields: [authorId], references: [id])
  target User        @relation("RatingTarget", fields: [targetId], references: [id])

  @@unique([clubId, authorId, targetId])
}

model SavingsClub {
  id             String       @id @default(uuid())
  name           String
  quotaAmount    Float
  durationUnit   DurationUnit @default(MONTH)
  durationCount  Int // number of weeks or months, per durationUnit
  frequency      Frequency    @default(MONTHLY) // cadence for WEEK-based clubs; always MONTHLY for MONTH-based clubs
  inviteCode     String       @unique
  status         ClubStatus   @default(PENDING)
  roundNumber    Int          @default(1) // incremented each time a completed/paused club is reactivated for a new round
  adminId        String
  admin          User         @relation("ClubAdmin", fields: [adminId], references: [id])

  // Schedule & rule settings
  startDate       DateTime? // anchors cycle 1 once the admin activates the club
  // day-of-month (1-31, clamped to short months) when durationUnit=MONTH; day-of-week (0=Sun..6=Sat) when durationUnit=WEEK
  paymentDueDay   Int
  payoutDay       Int
  lateFeeAmount   Float        @default(0)
  gracePeriodDays Int          @default(0) // days after the due date before a late fee applies

  // Pre-existing/ongoing club import: cycles before startCycleNumber are marked
  // completed externally so the club starts tracking from wherever it really is.
  isPreExisting    Boolean @default(false)
  startCycleNumber Int     @default(1)

  // Payment instructions shown to members on the report-payment page
  adminZelleInfo   String?
  adminCashAppInfo String?
  adminBankInfo    String?

  // Privacy: when false, non-admin members only see their own approved payment history
  allowMembersToViewOtherPayments Boolean @default(true)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        ClubMember[]
  paymentReports PaymentReport[]
  announcements  Announcement[]
  ratings        Rating[]
  cycles         ClubCycle[]
}

// Explicit, per-cycle due/payout dates. Generated when a club is activated
// (or immediately at creation for imported/pre-existing clubs), and freely
// editable afterward by the admin — dates are never recomputed from a formula
// once a cycle row exists.
model ClubCycle {
  id             String     @id @default(uuid())
  clubId         String
  cycleNumber    Int
  paymentDueDate DateTime
  payoutDate     DateTime
  payoutAmount   Float? // manual override of the pot the beneficiary receives; null falls back to quotaAmount * member count
  cycleFrequency Frequency? // optional informational override when this cycle's cadence differs from the club default
  isCompleted    Boolean    @default(false) // true for cycles before a pre-existing club's import point
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  club SavingsClub @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, cycleNumber])
}

model ClubMember {
  id         String      @id @default(uuid())
  clubId     String
  userId     String
  payoutTurn Int? // assigned turn number (1 to durationCount); null until the admin assigns it
  payoutPaid Boolean     @default(false)
  joinedAt   DateTime    @default(now())
  club       SavingsClub @relation(fields: [clubId], references: [id])
  user       User        @relation(fields: [userId], references: [id])

  @@unique([clubId, userId])
}

model PaymentReport {
  id            String              @id @default(uuid())
  clubId        String
  userId        String
  amount        Float
  paymentDate   DateTime
  method        PaymentMethod
  referenceNote String? // transaction ID, memo, or confirmation #
  receiptUrl    String? // image / screenshot data URL
  status        ReportStatus @default(PENDING)
  notes         String? // admin note left at approval/rejection time
  approvedAt    DateTime?
  approvedById  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  club       SavingsClub @relation(fields: [clubId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  approvedBy User?       @relation("ReportApprover", fields: [approvedById], references: [id])
}

model Announcement {
  id        String      @id @default(uuid())
  clubId    String
  authorId  String
  title     String
  content   String
  createdAt DateTime    @default(now())
  club      SavingsClub @relation(fields: [clubId], references: [id])
  author    User        @relation(fields: [authorId], references: [id])
}
